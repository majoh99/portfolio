---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollTop from '../components/ScrollTop.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Portafolio de Desarrolladora Frontend" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link id="favicon" rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon-light.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<ClientRouter />
	</head>
	<body class="bg-bg text-fg font-body antialiased selection:bg-accent selection:text-bg flex flex-col min-h-screen transition-colors duration-300">
		<!-- One continuous ambient layer (grain + glow) fixed behind the whole page, so the
		     background never seams or cuts at a section boundary. -->
		<div class="ambient-bg" aria-hidden="true">
			<div class="grain"></div>
			<div class="glow glow-soft w-[60vw] h-[60vw] max-w-[820px] max-h-[820px] -top-[15vw] -right-[10vw]"></div>
			<div class="glow glow-soft w-[50vw] h-[50vw] max-w-[680px] max-h-[680px] -bottom-[20vw] -left-[12vw]"></div>
		</div>
		<div class="cursor-glow" data-cursor-glow aria-hidden="true"></div>

		<Header />

		<main class="flex-grow">
			<slot />
		</main>

		<Footer />
		<ScrollTop />

		<script>
			// Scroll reveal: fades/lifts anything marked data-reveal into place once it enters
			// the viewport. Re-scans after Astro's view-transition swaps so it keeps working
			// on the projects/[slug] pages too.
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('in-view');
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
			);

			const observeReveals = () => {
				document.querySelectorAll('[data-reveal]:not(.in-view)').forEach((el) => observer.observe(el));
			};
			observeReveals();
			document.addEventListener('astro:after-swap', observeReveals);

			// Cursor glow: a soft radial highlight that eases toward the pointer. Skipped on
			// touch devices and when the person prefers reduced motion.
			// The glow element is replaced on every view-transition swap, so it is looked up
			// fresh each frame instead of being cached (a cached reference goes stale and the
			// glow silently stops following the cursor after navigating).
			const canHover = window.matchMedia('(pointer: fine)').matches;
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (canHover && !reduceMotion) {
				let targetX = window.innerWidth / 2;
				let targetY = window.innerHeight / 2;
				let currentX = targetX;
				let currentY = targetY;
				let active = false;
				let raf = 0;

				const getGlow = () => document.querySelector<HTMLElement>('[data-cursor-glow]');

				const render = () => {
					const glow = getGlow();
					if (glow) {
						currentX += (targetX - currentX) * 0.12;
						currentY += (targetY - currentY) * 0.12;
						glow.style.setProperty('--cx', `${currentX}px`);
						glow.style.setProperty('--cy', `${currentY}px`);
						glow.classList.toggle('is-active', active);
					}
					raf = requestAnimationFrame(render);
				};

				window.addEventListener(
					'pointermove',
					(e) => {
						targetX = e.clientX;
						targetY = e.clientY;
						active = true;
					},
					{ passive: true },
				);
				document.addEventListener('pointerleave', () => {
					active = false;
				});
				document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf));
				document.addEventListener('astro:after-swap', () => {
					cancelAnimationFrame(raf);
					raf = requestAnimationFrame(render);
				});

				raf = requestAnimationFrame(render);
			}
		</script>
	</body>
</html>

<style is:global>
	/* Custom scrollbar */
	::-webkit-scrollbar {
		width: 10px;
	}
	::-webkit-scrollbar-track {
		background: var(--bg); 
	}
	::-webkit-scrollbar-thumb {
		background: var(--border); 
		border-radius: 5px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--fg-muted); 
	}
</style>
