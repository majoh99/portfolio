---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/Projects.astro';
import Experience from '../components/home/Experience.astro';
import About from '../components/home/About.astro';
import { getEntry } from 'astro:content';

const profileElement = await getEntry('profile', 'info');

if (!profileElement) {
	throw new Error("Profile info not found in src/content/profile/info.json");
}

const profile = profileElement.data;
---

<Layout title={`${profile.name} | ${profile.title}`}>
	<Hero name={profile.name} title={profile.title} />
	<About bio={profile.bio} name={profile.name} image={profile.image} />
	<Experience />
	<Projects />
</Layout>
