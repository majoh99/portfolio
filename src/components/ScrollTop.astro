<button
  id="scroll-top"
  type="button"
  aria-label="Volver arriba"
  class="fixed bottom-6 right-6 z-50 w-12 h-12 rounded-full bg-card border border-border text-fg font-mono text-lg flex items-center justify-center shadow-[0_8px_20px_-10px_rgba(var(--shadow-rgb),0.35)] transition-all duration-[250ms] opacity-0 translate-y-4 pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0 data-[visible=true]:pointer-events-auto hover:-translate-y-1 hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
>
  <span aria-hidden="true">↑</span>
</button>

<script>
  // Listeners live on document/window so they survive ClientRouter DOM swaps.
  const update = () => {
    document.getElementById('scroll-top')?.setAttribute('data-visible', String(window.scrollY > 400));
  };
  window.addEventListener('scroll', update, { passive: true });
  document.addEventListener('astro:page-load', update);
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#scroll-top')) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
