---
const skills = [
  'Vue.js', 'TypeScript', 'JavaScript', 'Quasar', 'NestJS', 'Astro', 'Tailwind', 
  'Wordpress', 'Figma','HTML5', 'CSS3'
];
---

<div class="flex flex-wrap gap-3 justify-center">
  {skills.map(skill => (
    <span 
      class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 dark:bg-white/10 dark:text-gray-200 border border-gray-200 dark:border-white/10 hover:bg-purple-50 dark:hover:bg-purple-900/20 hover:text-purple-600 dark:hover:text-purple-300 hover:border-purple-200 dark:hover:border-purple-500/30 transition-all cursor-default"
    >
      {skill}
    </span>
  ))}
</div>
