---
const { name, title } = Astro.props;
const [firstLine, ...rest] = title.split(' ');
const secondLine = rest.join(' ');
const base = import.meta.env.BASE_URL;

const stack = ['VUE.JS', 'NEXT.JS', 'TYPESCRIPT', 'ASTRO', 'TAILWIND', 'QUASAR', 'NESTJS', 'FIGMA'];
const marquee = [...stack, ...stack];

const badges = [
	{ label: 'Vue.js', pos: 'top-[74px] right-40', rot: '-4deg', delay: '0s' },
	{ label: 'TypeScript', pos: 'top-[210px] right-[60px]', rot: '3deg', delay: '1.2s' },
	{ label: 'Astro', pos: 'top-[340px] right-[190px]', rot: '-2deg', delay: '2.4s' },
];
---

<section id="home" class="relative overflow-hidden min-h-screen flex flex-col bg-transparent text-fg">
	<div class="relative flex-1 flex px-6 md:px-[72px] pt-32 pb-16">
		<div class="absolute inset-0 px-6 md:px-[72px] pointer-events-none">
			<div class="relative h-full max-w-[1200px] mx-auto">
		{badges.map((b) => (
			<span
				class={`badge-float hidden lg:block absolute ${b.pos} font-mono text-xs bg-card border border-border text-fg-muted px-3.5 py-2 rounded-full shadow-[0_8px_20px_-10px_rgba(var(--shadow-rgb),0.15)]`}
				style={`--r:${b.rot};animation-delay:${b.delay}`}
			>
				{b.label}
			</span>
		))}
			</div>
		</div>

		<div class="relative w-full max-w-[1200px] mx-auto flex flex-col justify-center">
		<div class="fade-1 font-mono text-sm text-accent mb-[18px] flex items-center gap-2">
			<span class="dot-pulse inline-block w-2 h-2 rounded-full bg-success"></span>
			Disponible para trabajar
		</div>

		<h1 class="fade-2 font-display font-extrabold tracking-[-0.02em] leading-[0.92] text-[clamp(44px,7.5vw,96px)]">
			{firstLine}
			<span class="block -mt-1.5 text-transparent [-webkit-text-stroke:2px_var(--fg)]">{secondLine}</span>
		</h1>

		<p class="fade-3 mt-8 text-[19px] leading-[1.6] text-fg-muted max-w-[520px]">
			Soy
			<span class="relative text-fg font-semibold">
				{name}
				<span class="underline-draw absolute left-0 right-0 -bottom-0.5 h-[3px] bg-accent"></span>
			</span>. Hace +6 años convierto ideas en interfaces
			<span class="text-fg font-semibold">atractivas</span> y funcionales, pensadas para quien las usa.
		</p>

		<div class="fade-3 flex flex-wrap gap-4 mt-10">
			<a
				href={`${base}#projects`}
				class="bg-fg text-bg px-[30px] py-[15px] rounded-[10px] text-[15px] font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_24px_-8px_rgba(var(--shadow-rgb),0.35)]"
			>
				Ver Proyectos
			</a>
			<a
				href={`${base}#contact`}
				class="border-[1.5px] border-fg text-fg px-[30px] py-[15px] rounded-[10px] text-[15px] font-semibold transition-all duration-200 hover:bg-fg hover:text-bg"
			>
				Contáctame
			</a>
		</div>
		</div>
	</div>

	<div class="relative border-t border-border py-[22px] overflow-hidden whitespace-nowrap" aria-hidden="true">
		<div class="animate-marquee inline-flex font-mono text-[15px] text-marquee">
			{[0, 1].map(() => marquee.map((item) => (
				<>
					<span class="px-7">{item}</span>
					<span class="px-7">·</span>
				</>
			)))}
		</div>
	</div>
</section>
