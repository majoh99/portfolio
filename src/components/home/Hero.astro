---
const { name, title, image } = Astro.props;
---

<section id="home" class="min-h-screen flex flex-col justify-center items-center text-center gap-8 relative overflow-hidden py-32">
	<!-- Local Background Blobs -->
	<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
		<div class="absolute top-[10%] left-[10%] w-96 h-96 bg-purple-500/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] opacity-30 dark:opacity-20 animate-blob"></div>
		<div class="absolute top-[10%] right-[10%] w-96 h-96 bg-pink-500/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] opacity-30 dark:opacity-20 animate-blob animation-delay-2000"></div>
	</div>

	{image && (
		<div class="relative group animate-float">
			<div class="absolute -inset-1 bg-linear-to-r from-purple-600 to-pink-600 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
			<img 
				src={image} 
				alt={name} 
				class="relative w-40 h-40 md:w-56 md:h-56 rounded-full object-cover border-4 border-white dark:border-gray-900 shadow-2xl"
				width="224"
				height="224"
			/>
		</div>
	)}

	<div class="flex flex-col items-center gap-4 animate-slideUp">
		<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/10 text-green-700 dark:text-green-400 text-sm font-medium shadow-sm hover:shadow-md transition-shadow">
			<span class="relative flex h-3 w-3">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
				<span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
			</span>
			Disponible para trabajar
		</div>

		<h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-gray-900 dark:text-white">
			Hola, soy <br class="md:hidden" /> {name} <span class="inline-block animate-waveOrigin">👋</span>
		</h1>
		<p class="text-2xl md:text-4xl text-transparent bg-clip-text bg-linear-to-r from-purple-600 via-pink-600 to-blue-600 dark:from-purple-400 dark:via-pink-400 dark:to-blue-400 font-bold tracking-tight pb-2">
			{title}
		</p>
		<!-- <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto font-light">
			Desarrolladora Web & Ingeniera de Sistemas
		</p> -->
	</div>

	<div class="flex gap-4 animate-slideUp animation-delay-300">
		<a href="#projects" class="bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-8 py-3 rounded-full font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-all hover:scale-105 shadow-lg hover:shadow-xl">
			Ver Proyectos
		</a>
		<!-- <a href="#" class="bg-linear-to-r from-purple-600 to-pink-600 dark:from-purple-500 dark:to-pink-500 text-white px-8 py-3 rounded-full font-medium hover:opacity-90 transition-all hover:scale-105 shadow-lg hover:shadow-purple-500/25">
			Descargar CV
		</a> -->
		<a href="#contact" class="border border-gray-200 dark:border-white/10 bg-white/50 dark:bg-white/5 backdrop-blur-sm text-gray-900 dark:text-white px-8 py-3 rounded-full font-medium hover:bg-gray-50 dark:hover:bg-white/10 transition-all hover:scale-105">
			Contáctame
		</a>
	</div>

	<div class="flex gap-6 mt-8 animate-slideUp animation-delay-500">
		<a href="https://github.com/majoh99" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors transform hover:scale-110">
			<span class="sr-only">GitHub</span>
			<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
			</svg>
		</a>
		<a href="https://linkedin.com/in/mariam-rosal" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-blue-600 transition-colors transform hover:scale-110">
			<span class="sr-only">LinkedIn</span>
			<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
			</svg>
		</a>
	</div>
</section>
