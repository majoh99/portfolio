---
interface Props {
  bio: string;
  name: string;
  image?: string;
}

const { bio, name, image } = Astro.props;

const stats = [
  { value: '6+', label: 'Años de experiencia' },
  { value: '10+', label: 'Proyectos entregados' },
];

// Two compact rows drifting past each other — plain badges on the section's own
// background, no colored card behind them, paused on hover so they're easy to read.
const stackRows = [
  { items: ['Vue.js', 'TypeScript', 'Astro', 'Tailwind', 'Quasar', 'JavaScript'], dir: 'animate-marquee', speed: '30s' },
  { items: ['Node.js', 'NestJS', 'Figma', 'Capacitor', 'Docker', 'Git', 'WordPress'], dir: 'animate-marquee-reverse', speed: '34s' },
];
---

<section id="about" class="relative overflow-hidden bg-transparent text-fg px-6 md:px-[72px] py-16">
  <div class="relative grid lg:grid-cols-2 gap-12 lg:gap-20 lg:items-center max-w-[1200px] mx-auto">
    <div class="min-w-0 flex flex-col justify-center">
      <div class="font-mono text-[15px] text-accent mb-4" data-reveal>/SOBRE MÍ</div>
      <h2 class="font-display font-extrabold text-[clamp(34px,4vw,48px)] leading-[1.08] mb-6" data-reveal style="--delay:0.05s">Un gusto<br />conocerte</h2>
      {image && (
        <figure class="about-photo lg:hidden mb-8 w-[140px] h-[140px]" data-reveal style="--delay:0.08s">
          <img
            src={`${import.meta.env.BASE_URL}${image}`}
            alt={name}
            width="140"
            height="140"
            loading="lazy"
            class="w-full h-full object-cover rounded-full"
          />
        </figure>
      )}
      <p class="text-[17px] leading-[1.7] text-fg-muted mb-10" data-reveal style="--delay:0.1s">{bio}</p>

      <div class="flex flex-wrap gap-10">
        {stats.map((stat, i) => (
          <div class="border-l-2 border-accent pl-4 reveal-scale" data-reveal style={`--delay:${0.15 + i * 0.08}s`}>
            <div class="font-display text-[32px] font-extrabold">{stat.value}</div>
            <div class="font-mono text-xs text-subtle">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="min-w-0 reveal-scale" data-reveal style="--delay:0.15s">
      {image && (
        <figure class="about-photo hidden lg:block mb-10 w-[170px] h-[170px]">
          <img
            src={`${import.meta.env.BASE_URL}${image}`}
            alt={name}
            width="170"
            height="170"
            loading="lazy"
            class="w-full h-full object-cover rounded-full"
          />
        </figure>
      )}
      <div class="font-mono text-xs uppercase tracking-[0.06em] text-subtle mb-4">Stack Tecnológico</div>
      <div class="flex flex-col gap-2.5">
        {stackRows.map((row) => (
          <div class="stack-row">
            <div class={`stack-track ${row.dir}`} style={`animation-duration:${row.speed}`}>
              {[0, 1].map(() => row.items.map((label) => <span class="stack-pill">{label}</span>))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Circular portrait with an offset coral ring; lifts on hover */
  .about-photo {
    position: relative;
    transition: transform 0.25s ease;
  }
  .about-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(6px, 6px);
    border-radius: 9999px;
    border: 1.5px solid var(--accent);
    z-index: 0;
  }
  .about-photo img {
    position: relative;
    z-index: 1;
    box-shadow: 0 16px 32px -16px rgba(var(--shadow-rgb), 0.4);
  }
  :global(.dark) .about-photo img {
    filter: brightness(0.92);
  }
  .about-photo:hover {
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .about-photo { transition: none; }
  }

  .stack-row {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .stack-track {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: max-content;
  }
  /* Pausing on hover matters more than the lift: without it the row keeps sliding
     under the cursor, so the badge you're pointing at drifts away mid-hover. */
  .stack-row:hover .stack-track {
    animation-play-state: paused;
  }
  .stack-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    color: var(--fg-muted);
    background: var(--card);
    padding: 7px 15px;
    border-radius: 999px;
    border: 1px solid var(--border);
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .stack-pill:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-track { animation: none; }
    .stack-row { overflow-x: auto; }
  }
</style>
