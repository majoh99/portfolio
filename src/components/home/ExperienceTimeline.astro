---
import { getCollection, render } from 'astro:content';

const experience = await getCollection('experience');
const sortedExperience = experience.sort((a, b) => {
  if (!a.data.endDate && b.data.endDate) return -1;
  if (a.data.endDate && !b.data.endDate) return 1;
  return b.data.startDate.valueOf() - a.data.startDate.valueOf();
});

const experienceWithContent = await Promise.all(sortedExperience.map(async (entry) => {
  const { Content } = await render(entry);
  return { ...entry, Content };
}));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', { month: 'short', year: 'numeric' }).format(date);
};
---

<div class="relative space-y-10 before:absolute before:inset-0 before:ml-5 before:-translate-x-px before:h-full before:w-0.5 before:bg-linear-to-b before:from-purple-500/50 before:via-purple-300 before:to-transparent dark:before:from-purple-500/50 dark:before:via-purple-900/30">
  {experienceWithContent.map((item) => (
    <div class="relative pl-12 group">
      
      <!-- Icon/Dot -->
      <div class="absolute left-0 top-2 flex items-center justify-center w-10 h-10 rounded-full border-2 border-purple-200 dark:border-purple-900 bg-white dark:bg-gray-900 shadow-[0_0_15px_rgba(147,51,234,0.3)] z-10">
        <div class="w-3 h-3 bg-linear-to-r from-purple-500 to-pink-500 rounded-full group-hover:scale-125 transition-transform"></div>
      </div>
      
      <!-- Content Card -->
      <div class="p-8 rounded-3xl bg-white/50 dark:bg-white/5 border border-gray-100 dark:border-white/10 backdrop-blur-sm hover:bg-white/80 dark:hover:bg-white/10 transition-all duration-300 shadow-sm hover:shadow-xl dark:shadow-none w-full">
        
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6">
          <div class="space-y-1">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">{item.data.role}</h3>
            <div class="flex items-center gap-3">
              <span class="text-lg text-purple-600 dark:text-purple-400 font-semibold">{item.data.company}</span>
              {item.data.url && (
                <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-full bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 hover:scale-110 transition-transform">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              )}
            </div>
          </div>
          
          <div class="shrink-0">
            <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-white/10">
              {formatDate(item.data.startDate)} — {item.data.endDate ? formatDate(item.data.endDate) : 'Presente'}
            </span>
          </div>
        </div>

        <div class="prose prose-base dark:prose-invert max-w-none text-gray-600 dark:text-gray-300 leading-relaxed">
          <item.Content />
        </div>

        {item.data.skills && (
          <div class="flex flex-wrap gap-2 mt-8 pt-6 border-t border-gray-100 dark:border-white/5">
            {item.data.skills.map(skill => (
              <span class="text-xs font-bold px-3 py-1.5 rounded-lg bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-100 dark:border-purple-500/20">
                {skill}
              </span>
            ))}
          </div>
        )}
        
      </div>
    </div>
  ))}
</div>
