---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}proyectos/${project.id}`}
  data-category={project.data.category}
  class="card group flex flex-col bg-card border border-border rounded-2xl overflow-hidden transition-all duration-[250ms] ease-out hover:-translate-y-1.5 hover:border-accent/35 hover:shadow-[0_24px_48px_-20px_rgba(var(--shadow-rgb),0.28)] reveal-scale"
  data-reveal
  style={`--delay:${Math.min(index, 5) * 0.08}s`}
>
  <div class="shot-frame h-[168px] flex items-center justify-center p-4">
    <div class="shot-inner w-full h-full rounded-lg overflow-hidden border border-border/70">
      <img
        src={`${base}${project.data.image}`}
        alt={project.data.title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-[400ms] ease-out group-hover:scale-[1.04]"
      />
    </div>
  </div>

  <div class="p-6 flex flex-col flex-1">
    <h3 class="font-display text-[21px] font-bold leading-[1.2] mb-2.5">{project.data.title}</h3>
    <p class="text-sm leading-[1.6] text-fg-muted mb-4 line-clamp-3">{project.data.description}</p>

    <div class="flex flex-wrap gap-2 mb-4">
      {project.data.tags.map((tag) => (
        <span class="font-mono text-[11px] px-3 py-[5px] rounded-full border border-border bg-card text-fg-muted">{tag}</span>
      ))}
    </div>

    <div class="mt-auto font-mono text-[13px] flex items-center gap-1.5">
      Ver detalle
      <span class="text-accent transition-transform duration-200 group-hover:translate-x-1">→</span>
    </div>
  </div>
</a>
