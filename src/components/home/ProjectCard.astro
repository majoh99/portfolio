---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="group relative flex flex-col md:flex-row gap-6 bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 rounded-2xl overflow-hidden hover:shadow-xl dark:hover:shadow-purple-900/10 transition-all duration-300">
  <div class="w-full md:w-2/5 h-64 md:h-auto overflow-hidden">
    <img 
      src={`${import.meta.env.BASE_URL}${project.data.image}`} 
      alt={project.data.title}
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 md:hidden"></div>
  </div>
  
  <div class="flex-1 p-6 md:p-8 flex flex-col justify-center">
    <div class="flex flex-wrap gap-2 mb-4">
      {project.data.tags.map(tag => (
        <span class="px-3 py-1 text-xs font-semibold tracking-wide text-purple-600 dark:text-purple-300 bg-purple-50 dark:bg-purple-900/30 rounded-full">
          {tag}
        </span>
      ))}
    </div>

    <a href={`${import.meta.env.BASE_URL}proyectos/${project.id}`}>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3 bg-clip-text group-hover:text-transparent group-hover:bg-linear-to-r group-hover:from-purple-600 group-hover:to-pink-600 transition-all hover:underline decoration-purple-500/30 underline-offset-8">
        {project.data.title}
      </h3>
    </a>
    
    <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed line-clamp-3">
      {project.data.description}
    </p>

    <div class="flex flex-wrap gap-4 mt-auto">
      <a 
        href={`${import.meta.env.BASE_URL}proyectos/${project.id}`}
        class="inline-flex items-center gap-2 px-6 py-2.5 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors font-medium text-sm"
      >
        <span>Ver detalle</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      {project.data.link ? (
        <a 
          href={project.data.link} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors font-medium text-sm"
        >
          <span>Visitar</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ) : null}

      {project.data.repo && (
        <a 
          href={project.data.repo} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-gray-100 dark:bg-white/10 text-gray-900 dark:text-white rounded-lg hover:bg-gray-200 dark:hover:bg-white/20 transition-colors font-medium text-sm"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          <span>GitHub</span>
        </a>
      )}
    </div>
  </div>
</article>
