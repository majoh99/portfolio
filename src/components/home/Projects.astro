---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tabs = [
  { id: 'all', label: 'Todos' },
  { id: 'ecommerce', label: 'E-commerce' },
  { id: 'plataformas', label: 'Plataformas' },
];
---

<section id="projects" class="relative overflow-hidden bg-transparent text-fg px-6 md:px-[72px] py-16">
  <div class="relative max-w-[1200px] mx-auto">
    <div class="flex flex-wrap justify-between items-end gap-6 mb-7">
      <div>
        <div class="font-mono text-[15px] text-accent mb-2.5" data-reveal>/PROYECTOS</div>
        <h2 class="font-display font-extrabold text-[clamp(32px,4vw,46px)] max-w-[640px] leading-[1.1]" data-reveal style="--delay:0.05s">Lo que he construido</h2>
      </div>
      <a
        href={`${base}proyectos`}
        class="font-mono text-[13px] font-semibold border-[1.5px] border-fg px-5 py-[11px] rounded-full flex items-center gap-1.5 transition-all duration-200 hover:bg-fg hover:text-bg"
        data-reveal
        style="--delay:0.05s"
      >
        Ver todos <span>↗</span>
      </a>
    </div>

    <div role="tablist" class="flex gap-7 mb-[34px] border-b border-border" data-project-tabs data-reveal style="--delay:0.1s">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-filter={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="text-sm text-tab px-1 py-2 border-b-2 border-transparent -mb-px transition-colors duration-200 hover:text-fg aria-selected:text-fg aria-selected:border-accent aria-selected:font-medium"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-project-grid>
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </div>
</section>

<script>
  // Delegated so it survives ClientRouter DOM swaps.
  document.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-project-tabs] [data-filter]');
    if (!tab) return;
    const filter = tab.dataset.filter;
    tab.parentElement?.querySelectorAll('[data-filter]').forEach((t) => {
      t.setAttribute('aria-selected', String(t === tab));
    });
    document.querySelectorAll<HTMLElement>('[data-project-grid] [data-category]').forEach((card) => {
      card.hidden = filter !== 'all' && card.dataset.category !== filter;
    });
  });
</script>
