---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: `${import.meta.env.BASE_URL}#home`, label: 'Inicio' },
  { href: `${import.meta.env.BASE_URL}#about`, label: 'Sobre mí' },
  { href: `${import.meta.env.BASE_URL}#projects`, label: 'Proyectos' },
  { href: `${import.meta.env.BASE_URL}#contact`, label: 'Contacto' },
];
---

<header class="fixed top-0 left-0 w-full z-50 flex justify-center py-4 px-4">
  <nav class="flex items-center gap-6 px-6 py-3 rounded-full bg-white/80 dark:bg-black/30 backdrop-blur-md border border-gray-200 dark:border-white/10 shadow-lg ring-1 ring-black/5 dark:ring-white/10 transition-colors duration-300">
    <a href={import.meta.env.BASE_URL} class="text-xl font-bold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-600 dark:from-purple-400 dark:to-pink-400 mr-2">
      &lt;MR/&gt;
    </a>
    <div class="hidden md:flex gap-6">
      {links.map(link => (
        <a 
          href={link.href} 
          class="text-sm font-medium text-gray-700 dark:text-white/80 hover:text-purple-600 dark:hover:text-white transition-colors duration-300 relative group"
        >
          {link.label}
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-purple-600 dark:bg-purple-400 transition-all duration-300 group-hover:w-full"></span>
        </a>
      ))}
    </div>
    
    <div class="pl-2 border-l border-gray-200 dark:border-white/10 ml-2">
      <ThemeToggle />
    </div>
  </nav>
</header>
