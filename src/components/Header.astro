---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: `${import.meta.env.BASE_URL}#home`, label: 'Inicio' },
  { href: `${import.meta.env.BASE_URL}#about`, label: 'Sobre mí' },
  { href: `${import.meta.env.BASE_URL}#projects`, label: 'Proyectos' },
  { href: `${import.meta.env.BASE_URL}#contact`, label: 'Contacto' },
];
---

<header class="fixed top-0 left-0 w-full z-50 flex justify-center py-4 px-4 pointer-events-none">
  <nav class="pointer-events-auto flex items-center gap-6 px-6 py-3 rounded-full bg-bg/70 backdrop-blur-md border border-border shadow-[0_8px_30px_-12px_rgba(var(--shadow-rgb),0.25)] transition-colors duration-300">
    <a href={import.meta.env.BASE_URL} aria-label="Mariam Rosal — Inicio" class="mr-2 transition-opacity duration-200 hover:opacity-70">
      <img src={`${import.meta.env.BASE_URL}logo-dark-with-accent.svg`} alt="MR" width="80" height="22" class="h-[22px] w-auto dark:hidden" />
      <img src={`${import.meta.env.BASE_URL}logo-light-with-accent.svg`} alt="MR" width="80" height="22" class="h-[22px] w-auto hidden dark:block" />
    </a>
    <div class="hidden md:flex gap-6">
      {links.map(link => (
        <a
          href={link.href}
          class="text-sm font-medium text-fg-muted hover:text-fg transition-colors duration-200 relative group"
        >
          {link.label}
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-200 group-hover:w-full"></span>
        </a>
      ))}
    </div>

    <div class="pl-2 border-l border-border ml-2">
      <ThemeToggle />
    </div>
  </nav>
</header>
