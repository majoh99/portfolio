---
const year = new Date().getFullYear();
---

<footer class="bg-gray-100/40 dark:bg-black/40 backdrop-blur-md border-t border-gray-200 dark:border-white/10 mt-auto">
	<div class="max-w-5xl mx-auto px-4 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
		<div class="flex items-center gap-2">
			<span class="text-xl font-bold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-600 dark:from-purple-400 dark:to-pink-400">
				&lt;MR/&gt;
			</span>
			<span class="text-sm text-gray-500 dark:text-white/40">
				&copy; {year} Mariam Rosal
			</span>
		</div>
		
		

		<div class="text-sm text-gray-500 dark:text-white/40 flex items-center gap-1">
			Hecho con <span class="text-pink-500 animate-pulse">❤</span> por Mariam Rosal
		</div>
	</div>
</footer>
